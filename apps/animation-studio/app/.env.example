# Creator Cloud — browser-safe public configuration only.
VITE_OCP_CLOUD_API_URL=https://your-project.supabase.co/functions/v1/cloud-api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_OCP_CREATOR_PORTAL_URL=https://ocp-creator-staging.pages.dev/

# Sprite Sheet FX remains hidden from ordinary creators by default.
VITE_SPRITE_FX_MODE=admin
VITE_SPRITE_FX_ADMIN_PUBLISHERS=ocp.official
VITE_SPRITE_FX_CLOUD=false
