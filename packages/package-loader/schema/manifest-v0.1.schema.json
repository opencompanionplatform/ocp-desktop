{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.opencompanion.org/package/manifest-v0.1.schema.json",
  "title": "OCP package manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "type", "version", "publisher", "license", "entry", "assets", "signature"],
  "properties": {
    "manifestVersion": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
    "type": { "enum": ["character", "plugin", "voice", "effect-pack"] },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){2}(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "publisher": {
      "type": "object", "additionalProperties": false, "required": ["id", "keyId"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
        "keyId": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9._-]+$", "maxLength": 256 }
      }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 256 },
    "entry": { "$ref": "#/$defs/assetPath" },
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": { "path": { "$ref": "#/$defs/assetPath" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "digest", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9._-]+$", "maxLength": 256 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "value": { "type": "string", "pattern": "^base64:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    }
  },
  "$defs": {
    "assetPath": { "type": "string", "pattern": "^assets/(?:[^/\\\\.][^/\\\\]*)(?:/(?:[^/\\\\.][^/\\\\]*))*$", "maxLength": 1024 }
  }
}