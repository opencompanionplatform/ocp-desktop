{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencompanionplatform.github.io/ocp-spec/update-manifest-v1.schema.json",
  "title": "OCP Update Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "version", "publishedAt", "artifacts", "signature"],
  "properties": {
    "schema": { "const": "ocp-update/1" },
    "channel": { "enum": ["stable", "beta", "nightly"] },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publishedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "releaseNotesUrl": { "type": "string", "minLength": 8, "maxLength": 2048 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "arch", "url", "size", "sha256"],
        "properties": {
          "platform": { "enum": ["windows", "macos"] },
          "arch": { "enum": ["x86_64", "arm64"] },
          "url": { "type": "string", "minLength": 8, "maxLength": 2048 },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
